# mock: use local workbench fixtures. backend: call the FastAPI API.
VITE_API_MODE=backend

# Optional. Leave empty to use Vite dev proxy at /api.
VITE_API_BASE_URL=

# Vite dev proxy target used when VITE_API_BASE_URL is empty.
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Optional development token. Prefer saving localStorage["sunoscribe-access-token"] in Settings.
VITE_API_ACCESS_TOKEN=
